{
  "name": "enfeca-render-engine",
  "version": "0.4.8",
  "private": true,
  "type": "module",
  "description": "Enfeca Render encode engine — HD export on this machine",
  "main": "electron-main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "start:stable": "PORT=3850 AGENT_ISOLATED=1 node server.mjs",
    "start:dev": "PORT=3851 AGENT_ISOLATED=1 node server.mjs",
    "dev": "PORT=3851 AGENT_ISOLATED=1 node server.mjs",
    "electron": "electron .",
    "electron:dev": "PORT=3851 electron .",
    "dist": "electron-builder --mac dmg && node scripts/write-release-feed.mjs",
    "dist:arm64": "electron-builder --mac dmg --arm64 && node scripts/write-release-feed.mjs",
    "dist:x64": "electron-builder --mac dmg --x64 && node scripts/write-release-feed.mjs",
    "dist:all": "electron-builder --mac dmg --arm64 --x64 && node scripts/write-release-feed.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "ffmpeg-static": "^5.2.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-darwin-arm64": "1.0.3",
    "@napi-rs/canvas-darwin-x64": "1.0.3"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.enfec.explainer-render-agent",
    "productName": "Explainer Render Agent",
    "copyright": "Copyright © Enfec",
    "directories": {
      "output": "dist"
    },
    "artifactName": "Explainer-Render-Agent-${version}-${arch}.${ext}",
    "files": [
      "electron-main.mjs",
      "server.mjs",
      "lib/**/*",
      "public/**/*",
      "package.json",
      ".env.example",
      "node_modules/@napi-rs/**",
      "node_modules/ffmpeg-static/**"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "dmg": {
      "title": "Explainer Render Agent"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "ffmpeg-static@5.3.0": true
  }
}
