# Copy to .env on each machine (setup.sh does this automatically).
# Only RENDER_API_KEY and RENDER_MACHINE are required before rendering.
# Each Mac must use a different RENDER_MACHINE (this one: mac-d-macbook,
# the other: mac-enfec’s-macbook-pro).

STUDIO_URL=https://divstudio.lovable.app
RENDER_API_KEY=
RENDER_MACHINE=mac-d-macbook
AUTO_CLAIM=1
PORT=3849
AGENT_PORTS=3853,3854
OUT_DIR=data/out
